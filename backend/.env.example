# Server port
PORT=5000

# MongoDB Atlas connection string (from your .env)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/agriweigh?retryWrites=true&w=majority

# Optional custom DNS resolvers for networks whose local resolver refuses
# MongoDB Atlas SRV lookups (comma separated). Leave empty in normal setups.
# Example: MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=

# Secret API key the ESP32 must send in the x-api-key header.
# Generate a long random string and keep it identical here and in the firmware.
DEVICE_API_KEY=replace-with-a-long-random-string

# Device ID used for weighing records that do not include a device_id
DEFAULT_DEVICE_ID=AGRIWEIGHT-01

# A device is marked Offline when no telemetry is received for this long (ms)
OFFLINE_TIMEOUT_MS=45000
